    _generateFile "${_DirSource}/project_override.bash" "${_DirTarget}/lib/project_override.bash"

    return 0
}

_main() {
    logCall _main
    requireArguments $# 0

    logActivity "Generating temporary source files for manual synchronization"

    # NOTE: this script uses VisualDiffer, installed via Homebrew
    # REF: https://wiki.visualdiffer.com/
    # TODO: consider creating a link or alias to `visdiff`
    local -r _Exe=/Applications/VisualDiffer.app/Contents/Helpers/visdiff
    requireCommand ${_Exe}

    requireDirectoryIn prjDirTmp
    # shellcheck disable=SC2154
    local -r _DirGenerate="${prjDirTmp}/generate"
    maybeDeleteDirectoryTree "${_DirGenerate}"

    _generateFiles

    # shellcheck disable=SC2154
    execute "${_Exe}" --focus --no-warning --wait "${prjDirRoot}" "${_DirGenerate}"

    logDone "Generated source files synchronized (if YOU did your job)."
    return 0
}

_main "$@"

