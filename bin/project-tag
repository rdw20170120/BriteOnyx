#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# This script uses the BriteOnyx framework, as customized for this project
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash

requireDirectoryIn prjDirLib
# shellcheck disable=SC2154
source "${prjDirLib}"/project_override.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/abortOnFail.bash
source "${boDirLib}"/changeDirectoryIn.bash
source "${boDirLib}"/execute.bash
source "${boDirLib}"/gitStatusIsClean.bash
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash
source "${boDirLib}"/requireCommand.bash

logExecuting "${BASH_SOURCE[0]}"

_main() {
    executing "${BASH_SOURCE[0]}" "${FUNCNAME[0]}"
    # Apply a Git tag
    # Takes 0-1 arguments
    # NO: requireArguments $# 0

    requireCommand git

    if [[ $# -eq 0 ]]; then
        # changeDirectoryIn prjDirRoot
        # shellcheck disable=SC2154
        logInfo "Existing Git tags on this repository: ${prjDirRoot}"
        execute git tag
    elif [[ $# -eq 1 ]]; then
        logArgument "$1" 1 'version number (X.Y.Z) to apply as a Git tag'
        local -r _Tag=$1
        requireValue "${_Tag}"

        logActivity "Tagging Git repository as ${_Tag}"

        if gitStatusIsClean "${prjDirRoot}"; then
            execute git tag \
                --annotate "${_Tag}" \
                --message="Tag ${_Tag}"

            logDone 'Repository tagged'
        else
            abortOnFail 2 'Tagging aborted since Git working directory is dirty'
        fi
    else
        abortOnFail 1 "Requires 0-1 arguments instead of $#"
    fi

    return 0
}

_main "$@"

###################################################################################################
: <<'DisabledContent'
Troubleshooting Bash:
  set -o verbose; set -o xtrace
  # Code to troubleshoot
  set +o verbose; set +o xtrace
DisabledContent
