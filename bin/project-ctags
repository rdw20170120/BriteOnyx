#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2086,SC2128
# vim: set ft=bash:
set -EeTuo pipefail

source ${HOME}/.config/XDG.env
source ${XDG_CONFIG_HOME}/BO.env

# NOTE: This project uses the BriteOnyx framework
# shellcheck disable=SC2154
source ${boFramework}/bash/startup/from_script.bash
# shellcheck disable=SC2154
source ${boDirLib}/abortOnFail.bash
source ${boDirLib}/logging.bash
source ${boDirLib}/requireArguments.bash
source ${boDirLib}/requireCommand.bash
source ${boDirLib}/requireDirectoryIn.bash
# shellcheck disable=SC2154
source ${prjPathLib}/project_override.bash

logExecuting ${BASH_SOURCE}

_main() {
  requireArguments $# 0

  logActivity "Tagging project source files (using Universal CTags)"

  requireCommand ctags
  requireDirectoryIn prjDirRoot
  requireDirectoryIn prjDirTmp

  # shellcheck disable=SC2154
  local -r _FileLog=${prjDirRoot}/tmp/ctags.log

  # shellcheck disable=SC2154
  if ctags \
    --exclude='*.out' \
    --exclude='*.patterns' \
    --exclude='*.txt' \
    --exclude='.ran_*' \
    --exclude=.git \
    --exclude=.gitignore \
    --exclude=.ignore \
    --exclude=.mailmap \
    --exclude=ignore \
    --exclude=tags \
    --exclude=tmp \
    --guess-language-eagerly \
    --kinds-Sh=-h \
    --languages=-JSON,-Markdown,-TOML \
    --recurse=yes \
    --verbose \
    ${prjDirRoot} \
    >/dev/null \
    2>${_FileLog}; then
    :
  else
    abortOnFail $? "from 'ctags'"
  fi

  logDone "Project source files tagged."
  return 0
}

_main "$@"

###################################################################################################
: <<'DisabledContent'
--list-kinds=XXX
--list-languages
--options=XXX
--output-format=default
--tag-relative=always

    logInfo "Check log file for any issues: ${_FileLog}"
DisabledContent
