#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# Require project to already be activated (via `${prjDirRoot}/source_me.bash`)
requireDirectoryIn prjDirRoot

# This script uses the BriteOnyx framework, as customized for this project
source "${HOME}"/.config/XDG.env
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash
# shellcheck disable=SC2154
source "${prjDirLib}"/project_override.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/execute.bash
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash
source "${boDirLib}"/requireCommand.bash
source "${boDirLib}"/requireDirectoryIn.bash

logExecuting "${BASH_SOURCE[0]}"

_main() {
    # Takes NO arguments
    logCall _main
    requireArguments $# 0

    logActivity "Tagging project source files (using Universal CTags)"

    requireCommand ctags
    requireDirectoryIn prjDirRoot
    requireDirectoryIn prjDirTmp

    # shellcheck disable=SC2154
    local -r _FileLog=${prjDirTmp}/ctags.log

    # shellcheck disable=SC2154
    execute ctags \
        --exclude='*.out' \
        --exclude='*.patterns' \
        --exclude='*.txt' \
        --exclude='.ran_*' \
        --exclude=.git \
        --exclude=.gitignore \
        --exclude=.ignore \
        --exclude=.mailmap \
        --exclude=ignore \
        --exclude=tags \
        --exclude=tmp \
        --guess-language-eagerly \
        --kinds-Sh=-h \
        --languages=-JSON,-Markdown,-TOML \
        --recurse=yes \
        --verbose \
        "${prjDirRoot}" \
        >/dev/null \
        2>"${_FileLog}"

    logDone "Project source files tagged."
    return 0
}

_main "$@"

###################################################################################################
: <<'DisabledContent'
Troubleshooting Bash:
  set -o verbose; set -o xtrace
  # Code to troubleshoot
  set +o verbose; set +o xtrace

--list-kinds=XXX
--list-languages
--options=XXX
--output-format=default
--tag-relative=always

    logInfo "Check log file for any issues: ${_FileLog}"
DisabledContent
