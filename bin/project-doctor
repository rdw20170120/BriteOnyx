#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# Require project to already be activated (via `${prjDirRoot}/source_me.bash`)
requireDirectoryIn prjDirRoot

# This script uses the BriteOnyx framework, as customized for this project
source "${HOME}"/.config/XDG.env
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash
# shellcheck disable=SC2154
source "${prjDirLib}"/project_override.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash
source "${boDirLib}"/requireCommand.bash

logExecuting "${BASH_SOURCE[0]}"

_main() {
    logCall _main
    requireArguments $# 0

    logActivity "The doctor will see you now"

    # TODO: verify this list of commands is complete
    # TODO: research which commands can safely be "assumed" (e.g., `dirname`, etc?)
    requireCommand cat
    requireCommand ctags
    requireCommand diff
    requireCommand ghostty
    requireCommand git
    requireCommand gls
    requireCommand ln
    requireCommand rg
    requireCommand rm
    requireCommand seq
    requireCommand shellcheck
    requireCommand shfmt
    requireCommand tput
    requireCommand tset

    logDone "Your check-up is complete."
    return 0
}

_main "$@"

