#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# This script uses the BriteOnyx framework, as customized for this project
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash

requireDirectoryIn prjDirLib
# shellcheck disable=SC2154
source "${prjDirLib}"/project_override.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/changeDirectoryIn.bash
source "${boDirLib}"/execute.bash
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash
source "${boDirLib}"/requireCommand.bash

logExecuting "${BASH_SOURCE[0]}"

_main() {
    executing "${BASH_SOURCE[0]}" "${FUNCNAME[0]}"
    requireArguments $# 0

    logActivity 'Pulling project files from remote repository'

    requireCommand git

    changeDirectoryIn prjDirRoot
    execute git pull

    logDone 'Project files pulled'
    return 0
}

_main "$@"

###################################################################################################
: <<'DisabledContent'
Troubleshooting Bash:
  set -o verbose; set -o xtrace
  # Code to troubleshoot
  set +o verbose; set +o xtrace
DisabledContent
