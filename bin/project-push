#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# This script uses the BriteOnyx framework, as customized for this project
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash

requireDirectoryIn prjDirLib
# shellcheck disable=SC2154
source "${prjDirLib}"/project_override.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/abortOnFail.bash
source "${boDirLib}"/execute.bash
source "${boDirLib}"/gitStatusIsClean.bash
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash
source "${boDirLib}"/requireCommand.bash

logExecuting "${BASH_SOURCE[0]}"

_main() {
    executing "${BASH_SOURCE[0]}" "${FUNCNAME[0]}"
    requireArguments $# 0

    project-clean
    project-quality

    logActivity 'Pushing committed project file changes to remote repository'

    requireCommand git

    # shellcheck disable=SC2154
    if gitStatusIsClean "${prjDirRoot}"; then
        execute git push
    else
        abortOnFail 2 'Push aborted since Git working directory is dirty'
    fi

    logDone 'Project file changes pushed to remote repository'
    return 0
}

_main "$@"

###################################################################################################
: <<'DisabledContent'
Troubleshooting Bash:
  set -o verbose; set -o xtrace
  # Code to troubleshoot
  set +o verbose; set +o xtrace
DisabledContent
