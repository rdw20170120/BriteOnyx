#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# This script uses the BriteOnyx framework
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/requireCommand.bash

logExecuting "${BASH_SOURCE[0]}"

_main() {
    # Show 256-color palette in current terminal color theme
    # $1 = optional text
    # $2 = optional minimum background color index (at least 0)
    # $3 = optional maximum background color index (at most 255)
    requireCommand seq
    requireCommand tput

    local -r text=${1:-Hello world!}
    local -r min=${2:-0}
    local -r max=${3:-255}
    local -r n=$(tput sgr0) # Reset to normal colors
    # shellcheck disable=SC2086
    for i in $(seq --separator ' ' $min $max); do
        # shellcheck disable=SC2155
        local b=$(tput setab $i)
        for j in $(seq --separator ' ' 0 15); do
            # shellcheck disable=SC2155
            local f=$(tput setaf $j)
            echo -e "$f$b$j/$i ${text}$n"
        done
    done

    return 0
}

_main "$@"

