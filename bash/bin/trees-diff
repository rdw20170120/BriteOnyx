#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# This script uses the BriteOnyx framework
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/abortOnFail.bash
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash
source "${boDirLib}"/requireCommand.bash
source "${boDirLib}"/requireDirectory.bash

logExecuting "${BASH_SOURCE[0]}"

_compare() {
    # Compare file contents of directories $1 & $2, recursively
    # TODO: Enhance file/directory handling for robustness
    logCall _compare
    requireArguments $# 2
    logArgument "$1" 1 'first directory'
    logArgument "$2" 2 'second directory'

    requireCommand diff

    requireDirectory "$1"
    requireDirectory "$2"

    logDebug "Comparing directories $1 & $2"

    local Base
    local Node
    for Node in "$1"/*; do
        logDebug "Found node:  ${Node}"
        Base=$(basename "${Node}")
        if [[ -d "${Node}" ]]; then
            logDebug "Found directory:  ${Node}"
            if [[ -d "$2/${Base}" ]]; then
                _compare "$1/${Base}" "$2/${Base}"
                logDebug "Directories match:  $1/${Base} & $2/${Base}"
            else
                abortOnFail 1 "Unmatched directory:  $1/${Base}"
            fi
        elif [[ -f "${Node}" ]]; then
            logDebug "Found file:  ${Node}"
            if [[ -f "$2/${Base}" ]]; then
                if ! diff "$1/${Base}" "$2/${Base}" >/dev/null; then
                    abortOnFail 1 "Files differ:  $1/${Base} & $2/${Base}"
                else
                    logDebug "Files match:  $1/${Base} & $2/${Base}"
                fi
            else
                abortOnFail 1 "Unmatched file:  $1/${Base}"
            fi
        else
            abortOnFail 99 "Found unrecognized node:  ${Node}"
        fi
    done

    return 0
}

_parseArguments() {
    # Parse command-line arguments, if any
    logCall _parseArguments

    logTrace "Received $# command-line argument(s):  $*"
    if [[ $# -eq 0 ]]; then
        _showUsage
    else
        while [[ $# -gt 0 ]]; do
            case "$1" in
            --help)
                _showUsage
                break
                ;;
            *)
                if [[ -z "${Dir1}" ]]; then
                    Dir1=$1
                    logInfo "DIRECTORY1 = ${Dir1}"
                elif [[ -z "${Dir2}" ]]; then
                    Dir2=$1
                    logInfo "DIRECTORY2 = ${Dir2}"
                else
                    abortOnFail 1 "Extra positional arguments:  $*"
                fi
                shift
                ;;
            esac
        done
    fi

    return 0
}

# shellcheck disable=SC2120
_showUsage() {
    logCall _showUsage
    requireArguments $# 0

    logWarn "Usage:  trees-diff [OPTION...] DIRECTORY1 DIRECTORY2"
    # TODO: Add version
    requireCommand cat
    cat <<'USAGE'
  Compare file contents in DIRECTORY1 & DIRECTORY2 trees, recursively

  NOTE:
      Fails fast -> Stops on first difference or error.
      Does NOT allow extra files/directories under DIRECTORY1!
      Allows extra files/directories under DIRECTORY2.
      ONLY subdirectories and regular files are allowed!
      Metadata (ownership, permissions, times, etc.) are ignored.

  OPTION:
    --help -> Help the user by showing this usage.

  EXIT STATUS:
     0 -> No differences were found.
     1 -> Differences were found.
    >1 -> An error occurred.
USAGE

    return 0
}

_main() {
    logCall _main
    # NO: requireArguments

    logActivity "Comparing file contents in two directory trees"

    local Dir1=
    local Dir2=
    _parseArguments "$@"
    _compare "${Dir1}" "${Dir2}"

    logDone "Directory trees have same contents, no differences found."
    return 0
}

_main "$@"

###################################################################################################
