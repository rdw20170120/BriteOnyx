#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# This script uses the BriteOnyx framework
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash
source "${boDirLib}"/requireCommand.bash

logExecuting "${BASH_SOURCE[0]}"

_describeColor() {
    executing "${BASH_SOURCE[0]}" "${FUNCNAME[0]}"
    # Write a line describing a terminal color
    # using `tput`
    # and by directly using ANSI escape sequences
    # $1 = foreground color index
    # $2 = foreground color ANSI code
    # $3 = name for typical ANSI color at this index
    requireArguments $# 3
    # TODO: logArgument "$1" 1 'DESCRIPTION'
    # TODO: logArgument "$1" 1 'DESCRIPTION'
    # TODO: logArgument "$1" 1 'DESCRIPTION'

    requireCommand tput

    declare -r _Normal=$(tput sgr0)
    declare -r _Postfix="$3"
    declare -r _Prefix="This is typically"
    declare -r _ViaAnsi="\e[0;$2m"
    # shellcheck disable=SC2086
    declare -r _ViaTput=$(tput setaf $1)
    echo -e "${_ViaAnsi}$1  (ANSI) ${_Prefix}${_Normal} ${_ViaTput}(tput) ${_Postfix}${_Normal}"
}

_main() {
    executing "${BASH_SOURCE[0]}" "${FUNCNAME[0]}"
    # Describe current terminal
    requireArguments $# 0

    requireCommand ghostty
    requireCommand rg
    requireCommand tput
    requireCommand tset

    # shellcheck disable=SC2034
    declare -r boLogLevel=7

    logActivity 'Describing current terminal'

    logInfo 'Terminal identification:'
    logVariable COLORTERM
    logVariable TERM
    logVariable TERM_PROGRAM
    logValue "$(tput longname)" 'tput longname'
    logValue "$(tset -q)" 'tset -q'
    logValue "$(ghostty +show-config | rg theme)" 'Ghostty theme'

    logInfo 'Current 16-color palette:'
    _describeColor 0 30 'black'
    _describeColor 1 31 'dark red'
    _describeColor 2 32 'dark green'
    _describeColor 3 33 'dark yellow'
    _describeColor 4 34 'dark blue'
    _describeColor 5 35 'dark magenta'
    _describeColor 6 36 'dark cyan'
    _describeColor 7 37 'dark gray'
    _describeColor 8 90 'light black'
    _describeColor 9 91 'light red'
    _describeColor 10 92 'light green'
    _describeColor 11 93 'light yellow'
    _describeColor 12 94 'light blue'
    _describeColor 13 95 'light magenta'
    _describeColor 14 96 'light cyan'
    _describeColor 15 97 'light gray'

    return 0
}

_main "$@"

