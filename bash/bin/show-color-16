#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# This script uses the BriteOnyx framework
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash
source "${boDirLib}"/requireCommand.bash

logExecuting "${BASH_SOURCE[0]}"

_main() {
    executing "${BASH_SOURCE[0]}" "${FUNCNAME[0]}"
    # Show 16-color palette in current terminal color theme
    requireArguments $# 0

    requireCommand seq
    requireCommand tput

    local colors
    local -r n=$(tput sgr0) # Reset to normal colors
    echo "Showing 16-color palette for current theme, foreground/background"
    for i in $(seq --separator ' ' 0 15); do
        # shellcheck disable=SC2086,SC2155
        local b=$(tput setab $i)
        local text=""
        for j in $(seq --separator ' ' 0 15); do
            # shellcheck disable=SC2086,SC2155
            local f=$(tput setaf $j)
            # shellcheck disable=SC2086
            printf -v colors '%02d/%02d' $j $i
            text+="$b$f${colors} $n"
        done
        echo -e "$f$b${text}$n"
    done

    return 0
}

_main "$@"

