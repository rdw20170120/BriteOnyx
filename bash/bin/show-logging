#!/usr/bin/env bash
# shellcheck disable=SC1091
# vim: set ft=bash:
set -EeTuo pipefail

# Uncomment for debugging/development
# boLogLevel=7
# export boLogLevel

# This script uses the BriteOnyx framework
# shellcheck disable=SC2154
source "${boFramework}"/bash/startup/from_script.bash

# Dependencies:
# shellcheck disable=SC2154
source "${boDirLib}"/logging.bash
source "${boDirLib}"/requireArguments.bash

logExecuting "${BASH_SOURCE[0]}"

_main() {
    # Show logging examples
    # Takes NO arguments
    logCall _main
    requireArguments $# 0

    # shellcheck disable=SC2034
    local -r boLogLevel=7
    logActivity "Showing logging"

    logAction "Temporarily overrode boLogLevel to show all message kinds"
    logDebug "'boLogLevel=0' will disable all logging messages"
    logDebug "'boLogLevel=5' is the default"
    logDebug "'boLogLevel=7' will enable all logging messages"
    logVariable boLogLevel

    logBad "(1) This is a BAD message (big failure)."
    logError "(2) This is an error message."
    logWarn "(3) This is a warning message."
    logInfo "(4) This is an informational message."
    logGood "(5) This is a GOOD message (big success)."
    logTrace "(6) This is a tracing message."
    logDebug "(7) This is a debugging message."

    logAction "For when a script executes some action"
    logActivity "For when a script begins some activity"
    logDone "For when a script successfully completes some activity"
    logExecuting "SCRIPT_NAME"

    return 0
}

_main "$@"

###################################################################################################
